# ── Wiper Intel — Environment Variables ──────────────────────────────────────────
# Copy this to .env and fill in your values

# ── Shared ──────────────────────────────────────────────────────────────────────
# API key shared between scraper and Vercel endpoints
WIPER_INTEL_SECRET=your-secret-key-here

# ── Cloud Run Scraper ───────────────────────────────────────────────────────────
# Vercel ingest endpoint URL
INGEST_URL=https://dashboard-theta-five-15.vercel.app/api/ingest

# (Optional) GCS bucket for HTML snapshot archival
GCS_BUCKET=

# (Optional) Anthropic API key for AI-powered promo summaries
# Enables: Researcher AI extraction, Analyst landscape summaries,
#          /api/summarize endpoint
ANTHROPIC_API_KEY=

# ── GCP Deployment ──────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=australia-southeast1

# ── Vercel (set in Vercel dashboard, not here) ──────────────────────────────────
# KV_REST_API_URL=          (auto-set by Vercel KV)
# KV_REST_API_TOKEN=        (auto-set by Vercel KV)

# ── Email Digest ────────────────────────────────────────────────────────────────
ALERT_TO=matthew@wipertech.com.au
ALERT_FROM=alerts@wipertech.com.au
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Tuning ──────────────────────────────────────────────────────────────────────
# Price change alert threshold (dollars)
PRICE_ALERT_THRESHOLD=1.00

# Minimum history days before anomaly detection activates
MIN_HISTORY_FOR_ANOMALY=14

# Z-score threshold for anomaly alerts
ANOMALY_SIGMA=2.0

# Rate limiting (requests per window per IP)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60

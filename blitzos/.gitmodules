# BlitzOS member repos — pinned by reference (gitlinks), source never vendored.
# Initialized by bootstrap.sh with a fine-grained token, or selected via
# Anthropic's native GitHub rail at launch. All entries share owner MJB1000
# so a single fine-grained token covers the fleet.

[submodule "CLAUDE-CODE-V1"]
	path = repos/CLAUDE-CODE-V1
	url = https://github.com/MJB1000/CLAUDE-CODE-V1.git
	branch = main
